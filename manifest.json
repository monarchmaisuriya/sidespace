{
  "manifest_version": 3,
  "name": "Sidespace",
  "version": "0.3.0",
  "description": "Open any website as tabs in Chrome's side panel.",
  "minimum_chrome_version": "128",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Sidespace",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "src/panel/sidepanel.html"
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "declarativeNetRequestWithHostAccess",
    "favicon"
  ],
  "optional_permissions": ["bookmarks"],
  "host_permissions": ["<all_urls>"],
  "incognito": "not_allowed",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/frame-bridge.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/window-open.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open Sidespace"
    },
    "open-current-tab-in-panel": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Open the current page in Sidespace"
    }
  }
}
